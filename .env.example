# Copy this to .env and fill in your key
# The backend reads .env automatically when launched from the project directory.

NEBIUS_API_KEY=your_nebius_api_key_here

# Camera stays off until explicitly enabled. Install backend_python[vision] first.
BLOB_CAMERA_ENABLED=0
BLOB_CAMERA_DEVICE_INDEX=0

# Optional stable locations for persistent memory and enrolled face samples.
# BLOB_MEMORY_DB_PATH=/home/you/.blob/memory/chromadb
# BLOB_FACE_DB_PATH=/home/you/.blob/faces
# BLOB_SKILLS_DIR_PATH=/home/you/.blob/skills
